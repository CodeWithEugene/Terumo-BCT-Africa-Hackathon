# Copy this file to ".env" and fill in the values. Never commit ".env".
# The app runs without any of these. They are only needed for optional parts.

# Signs the sign-in cookie. Set any long random text. A development value is used if empty.
SP_SESSION_SECRET=

# Set to 1 wherever the app is served over HTTPS, so the sign-in cookie is never sent in the clear.
SP_COOKIE_SECURE=0

# Addresses (host:port, comma-separated) allowed to send changes besides the server's own.
# The default covers the development frontend. Add your public address when deployed.
# SP_ALLOWED_ORIGINS=localhost:5173,127.0.0.1:5173

# The three test log-ins are shown on the sign-in screen for the demo. Set to 0 to hide them.
SP_DEMO_LOGINS=1

# Optional: where the local database file lives (default: data/app.db)
# SP_DB_PATH=

# Optional: central database sync (Step 10). Leave empty to skip the sync.
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=
ORACLE_WALLET_DIR=wallet
ORACLE_WALLET_PASSWORD=
