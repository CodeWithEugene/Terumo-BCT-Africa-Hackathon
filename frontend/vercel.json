{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://sanguis-providus-api.onrender.com/api/:path*" },
    { "source": "/fhir/:path*", "destination": "https://sanguis-providus-api.onrender.com/fhir/:path*" },
    { "source": "/export/:path*", "destination": "https://sanguis-providus-api.onrender.com/export/:path*" }
  ]
}
